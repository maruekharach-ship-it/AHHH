-- เปิด / ปิด UI
local isGuiVisible = true
local function toggleGui()
	isGuiVisible = not isGuiVisible
	MainFrame.Visible = isGuiVisible
end

CloseButton.MouseButton1Click:Connect(toggleGui)
ToggleButton.MouseButton1Click:Connect(toggleGui)

-- คำนวณ TP Walk
local tpWalkEnabled = false
local tpMultiplier = 2 -- ค่าตัวคูณระดับความเร็ว

SpeedInput.FocusLost:Connect(function()
	local num = tonumber(SpeedInput.Text)
	if num then
		tpMultiplier = num
	else
		SpeedInput.Text = tostring(tpMultiplier)
	end
end)

TPWalkBtn.MouseButton1Click:Connect(function()
	tpWalkEnabled = not tpWalkEnabled
	if tpWalkEnabled then
		TPWalkBtn.Text = "ระบบวาร์ปเดิน: เปิดใช้งาน"
		TPWalkBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
	else
		TPWalkBtn.Text = "ระบบวาร์ปเดิน: ปิดใช้งาน"
		TPWalkBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
	end
end)

-- ใช้ Heartbeat ในการวาร์ประยะทางแบบทวีคูณ (ปรับนิดเดียวก็พุ่งเร็ว)
RunService.Heartbeat:Connect(function()
	if tpWalkEnabled and Character and Humanoid and RootPart then
		if Humanoid.MoveDirection.Magnitude > 0 then
			-- เพิ่มตัวคูณ x50 เข้าไป เพื่อให้กรอกตัวเลขน้อยๆ (เช่น 1, 2, 3) ก็พุ่งเร็วได้ทันที
			RootPart.CFrame = RootPart.CFrame + (Humanoid.MoveDirection * (tpMultiplier * 0.5))
		end
	end
end)

-- ระบบหยุดเวลา
local timeFrozen = false

FreezeBtn.MouseButton1Click:Connect(function()
	timeFrozen = not timeFrozen
	
	if timeFrozen then
		FreezeBtn.Text = "หยุดเวลา: เปิดใช้งาน"
		FreezeBtn.BackgroundColor3 = Color3.fromRGB(220, 120, 0)
		
		if RootPart then
			RootPart.Anchored = true
		end
	else
		FreezeBtn.Text = "หยุดเวลา: ปิดใช้งาน"
		FreezeBtn.BackgroundColor3 = Color3.fromRGB(50, 100, 180)
		
		if RootPart then
			RootPart.Anchored = false
		end
	end
end)
